# Copy this file to .env and fill it in. .env is git-ignored: NEVER commit real keys.
# Use NEW MetaMask accounts created only for this testnet demo, never a wallet that holds real money.

# Optional: your own RPC endpoint (e.g. from Alchemy or Infura). Defaults to Polygon's public Amoy RPC.
AMOY_RPC_URL=

# Deploys the contract and becomes admin + project developer. Needs test POL from https://faucet.polygon.technology
DEPLOYER_PRIVATE_KEY=

# A second account that becomes the independent verifier (a developer can't verify their own project).
# Needs a little test POL too. Leave empty to deploy without verifying/listing the sample projects.
VERIFIER_PRIVATE_KEY=

# Optional: three community wallet addresses (comma-separated) for the sample projects.
# If empty, fresh random addresses are generated (sale proceeds sent there are just for the demo).
COMMUNITY_WALLETS=
